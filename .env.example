# 在终端选择 Conda 环境：MATHS_CONDA_ENV=intern bash start.sh
# 或指定 Python 解释器：MATHS_PYTHON=/path/to/python bash start.sh
# 以上解释器选择变量需在终端设置；默认使用 Conda intern 环境。
# 终端已导出的环境变量优先于本文件中的配置。
# 后端模型 API 密钥，必填；不要提交真实密钥。
INTERN_API_KEY=
# 解题模型名称。
INTERN_MODEL=intern-s2-preview
# LangSmith 云端追踪：开启后上传图节点和模型调用的层级、耗时及脱敏错误。
# 会上传脱敏后的题目、提示词、节点 state、模型回复及 token 用量。
# 过滤密钥、认证头、客户端对象及本地路径；不会自动验证云端连通性。
LANGSMITH_TRACING=false
# 与解题模型 Key 独立，从 LangSmith 设置中创建，切勿提交真实密钥。
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=math-reasoning
# 默认美国区；其他区域或私有部署请使用对应的 API 地址。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 可选：自定义模型接口完整地址；不设置时使用默认 Intern 接口。
# INTERN_API_BASE=https://chat.intern-ai.org.cn/api/v1/chat/completions

# Web 与后端共用端口，页面地址为 http://127.0.0.1:8010/chat/。
MATHS_WEB_PORT=8010
# 启动器进程记录、锁文件及 runtime.log 日志的保存目录。
MATHS_WEB_STATE_DIR=local_state/web_launcher
# 题目附件存储目录；不同后端实例必须使用独立目录。
MATHS_QUESTION_DIR=local_state/chat_questions
# 后端启动后等待健康检查通过的最长时间，单位为秒。
MATHS_STARTUP_TIMEOUT=120
# 工具调用协议，可选 auto、native、json、off。
MATHS_FUNCTION_CALLING=off
# 可选：用于检查点兼容校验的客户端身份；更换模型或版本时应同步调整。
# MATHS_CLIENT_IDENTITY=intern/intern-s2-preview/local-v1

# 是否启用策略检索。
STAGED_STRATEGY_RETRIEVAL_ENABLED=true
# hybrid：词法与向量混合检索；lexical：仅词法检索；
# legacy_embedding：原向量检索；disabled：禁用策略检索。
# 向量检索需先安装 requirements-platform-m5.txt 中的依赖。
# 本地模型目录：strategyrag/Qwen3-Embedding-0.6B；索引目录：strategy_data/。
STAGED_STRATEGY_RETRIEVAL_MODE=hybrid

# 可选：连接已启动的 Redis，需启用 AOF 并设置 appendfsync always。
# 启动脚本会检查连接及持久化配置，但不会自动启动 Redis。
# 不设置时，会话与任务保存在进程内存中，重启后不会自动保留。
# MATHS_CHAT_REDIS_URL=redis://127.0.0.1:6388/0
# Redis 数据命名空间；保留相同连接与命名空间才能继续读取已有历史。
MATHS_CHAT_NAMESPACE=maths:chat:v1
